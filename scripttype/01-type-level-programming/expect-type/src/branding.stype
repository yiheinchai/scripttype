// ✗ DeepBrand: uses raw() — language gap, does not count as covered
//   gap: type node ConstructorType
/* @scripttype preserveParamNames */
export function DeepBrand(T: unknown, Options: DeepBrandOptions) {
  if (matches<true>(IsNever(T))) {
    return { type: 'never' }
  }
  if (matches<true>(IsAny(T))) {
    return { type: 'any' }
  }
  if (matches<true>(IsUnknown(T))) {
    return { type: 'unknown' }
  }
  if (matches<infer Nominal>(NominalType(T, Options))) {
    if (matches<true>(IsNever(Nominal))) {
      if (matches<string | number | boolean | symbol | bigint | null | undefined | void>(T)) {
        return { type: 'primitive', value: T }
      }
      if (matches<new (...args: any[]) => any>(T)) {
        return { type: 'constructor', params: ConstructorOverloadParameters(T), instance: DeepBrand(InstanceType(Extract(T, raw('new (...args: any) => any'))), Options) }
      }
      if (matches<(...args: infer P) => infer R>(T)) {
        if (matches<1>(NumOverloads(T))) {
          return { type: 'function', params: DeepBrand(P, Options), return: DeepBrand(R, Options), this: DeepBrand(ThisParameterType(T), Options), props: DeepBrand(Omit(T, keyof(Function)), Options) }
        }
        if (matches<infer OverloadsTuple>(UnionToTuple(OverloadsInfoUnion(T)))) {
          const m1 = {}
          for (const K in keyof(OverloadsTuple)) {
            m1[K] = DeepBrand(OverloadsTuple[K], Options)
          }
          return { type: 'overloads', overloads: m1 }
        }
        return never
      }
      if (matches<any[]>(T)) {
        if (matches<true>(IsTuple(T))) {
          const m2 = {}
          for (const K in keyof(T)) {
            m2[K] = DeepBrand(T[K], Options)
          }
          return { type: 'tuple', items: m2 }
        }
        return { type: 'array', items: DeepBrand(T[number], Options) }
      }
      if (matches<true>(IsRecord(T))) {
        return { type: 'record', keys: keyof(T), values: DeepBrand(T[keyof(T)], Options) }
      }
      const m3 = {}
      for (const K in keyof(T)) {
        m3[K] = DeepBrand(T[K], Options)
      }
      return { type: 'object', properties: m3, readonly: ReadonlyKeys(T), required: RequiredKeys(T), optional: OptionalKeys(T), constructorParams: matches<infer P>(ConstructorOverloadParameters(T)) ? (matches<true>(IsNever(P)) ? never : DeepBrand(P, Options)) : never }
    }
    return { type: Nominal }
  }
  return never
}

// ✓ StrictEqualUsingBranding: verified type-identical to the original
/* @scripttype preserveParamNames */
export function StrictEqualUsingBranding(Left: unknown, Right: unknown, Options: DeepBrandOptions) {
  return MutuallyExtends(DeepBrand(Left, Options), DeepBrand(Right, Options))
}
/* compiles to:
 * export type StrictEqualUsingBranding<Left, Right, Options extends DeepBrandOptions> = MutuallyExtends<DeepBrand<Left, Options>, DeepBrand<Right, Options>>
 */


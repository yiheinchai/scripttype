  }
  if (matches<T>(number)) {
    return 'number'
  }
  if (matches<number>(T)) {
    return `literal number: ${T}`
  }
  if (matches<T>(bigint)) {
    return 'bigint'
  }
  if (matches<bigint>(T)) {
    return `literal bigint: ${T}`
  }
  if (matches<null>(T)) {

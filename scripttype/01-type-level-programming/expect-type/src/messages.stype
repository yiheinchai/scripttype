// ✓ Scolder: verified type-identical to the original
/* @scripttype preserveParamNames */
export function Scolder(Expecter: {result: boolean}, Options: {positive: boolean}) {
  if (matches<Options['positive']>(Expecter['result'])) {
    return fnType([], true)
  }
  if (matches<true>(Options['positive'])) {
    return Expecter
  }
  return Inverted(Expecter)
}

      m1[K] = MismatchInfo(matches<keyof Actual>(K) ? Actual[K] : never, matches<keyof Expected>(K) ? Expected[K] : never, Options)
    }
    return Optionalify(m1, OptionalKeys(Expected))
  }
  if (matches<true>(StrictEqualUsingBranding(Actual, Expected, Options))) {
    return Actual
  }
  return `Expected: ${PrintType(Expected)}, Actual: ${PrintType(Exclude(Actual, Expected))}`
}

// ✓ Optionalify: verified type-identical to the original
/* @scripttype preserveParamNames */
export function Optionalify(T: unknown, TOptionalKeys: unknown) {
  if (matches<[ never ]>([TOptionalKeys])) {
    return T
  }
  const m1 = {}
  for (const K in keySet(Exclude(keyof(T), TOptionalKeys))) {
    m1[K] = T[K]
  }
  const m2 = {}
  for (const K in keySet(Extract(keyof(T), TOptionalKeys))) {
    m2[K] = optional(T[K])
  }
  if (matches<infer X>(m1 & m2)) {
    const out = {}
    for (const K in keyof(X)) {
      out[K] = X[K]
    }
    return out
  }
  return never
}

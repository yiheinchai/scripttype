/* @scripttype preserveParamNames */
export function ConstructorOverloadsUnion(ConstructorType: unknown) {
  if (matches<true>(IsNever(TSPost53ConstructorOverloadsInfoUnion(raw('new (a: 1) => any'))))) {
    return TSPre53ConstructorOverloadsInfoUnion(ConstructorType)
  }
  return TSPost53ConstructorOverloadsInfoUnion(ConstructorType)
}


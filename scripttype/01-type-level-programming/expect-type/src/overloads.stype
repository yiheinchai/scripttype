    return raw('new (...p: A1) => R1') | raw('new (...p: A2) => R2') | raw('new (...p: A3) => R3') | raw('new (...p: A4) => R4') | raw('new (...p: A5) => R5') | raw('new (...p: A6) => R6') | raw('new (...p: A7) => R7') | raw('new (...p: A8) => R8') | raw('new (...p: A9) => R9') | raw('new (...p: A10) => R10')

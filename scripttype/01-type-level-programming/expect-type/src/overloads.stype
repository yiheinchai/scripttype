// ✓ TSPre53ConstructorOverloadsInfoUnion: verified type-identical to the original
/* @scripttype preserveParamNames */
export function TSPre53ConstructorOverloadsInfoUnion(ConstructorType: unknown) {
  if (matches<infer Tup>(Tuplify(DecreasingConstructorOverloadsInfoUnion(ConstructorType)))) {
    if (matches<[ infer Ctor ]>(Tup)) {
      if (matches<true>(IsUselessConstructorOverloadInfo(Ctor))) {
        return never
      }
      return Ctor
    }
    return never
  }
  return never
}

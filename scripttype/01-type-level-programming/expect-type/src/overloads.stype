// ✓ TSPre53OverloadThisParameterTypes: verified type-identical to the original
/* @scripttype preserveParamNames */
export function TSPre53OverloadThisParameterTypes(FunctionType: unknown) {
  if (matches<infer TupleType>(Tuplify(DecreasingOverloadsInfoUnionWithThis(FunctionType)))) {
    if (matches<[ infer OverloadedFunctionType ]>(TupleType)) {
      if (matches<true>(IsUselessOverloadInfo(OverloadedFunctionType))) {
        return never
      }
      if (matches<(this: infer InferredThisType, ...args: any[]) => any>(OverloadedFunctionType)) {
        return InferredThisType
      }
      return never
    }
    return never
  }
  return never
}
/* compiles to:
 * export type TSPre53OverloadThisParameterTypes<FunctionType> = Tuplify<DecreasingOverloadsInfoUnionWithThis<FunctionType>> extends infer TupleType ? TupleType extends [infer OverloadedFunctionType] ? IsUselessOverloadInfo<OverloadedFunctionType> extends true ? never : OverloadedFunctionType extends (this: infer InferredThisType, ...args: any[]) => any ? InferredThisType : never : never : never
 */

// ✓ OverloadThisParameterTypes: verified type-identical to the original
/* @scripttype preserveParamNames */
export function OverloadThisParameterTypes(FunctionType: unknown) {
  if (matches<(...args: any[]) => any>(FunctionType)) {
    if (matches<true>(IsNever(TSPost53OverloadsInfoUnion(fnType([1], 2))))) {
      return TSPre53OverloadThisParameterTypes(FunctionType)
    }
    return TSPost53OverloadThisParameterTypes(FunctionType)
  }
  return ThisParameterType(FunctionType)
}
/* compiles to:
 * export type OverloadThisParameterTypes<FunctionType> = FunctionType extends (...args: any[]) => any ? IsNever<TSPost53OverloadsInfoUnion<(a0: 1) => 2>> extends true ? TSPre53OverloadThisParameterTypes<FunctionType> : TSPost53OverloadThisParameterTypes<FunctionType> : ThisParameterType<FunctionType>
 */

// ✓ SelectOverloadsInfo: verified type-identical to the original
/* @scripttype preserveParamNames */
export function SelectOverloadsInfo(Union: UnknownFunction, Args: unknown[]) {
  if (matches<InferFunctionType<infer Fn>>(Union)) {
    if (matches<Parameters<Fn>>(Args)) {
      return Fn
    }
    return never
  }
  return never
}
/* compiles to:
 * export type SelectOverloadsInfo<Union extends UnknownFunction, Args extends unknown[]> = Union extends InferFunctionType<infer Fn> ? Args extends Parameters<Fn> ? Fn : never : never
 */

// ✓ OverloadsNarrowedByParameters: verified type-identical to the original
/* @scripttype preserveParamNames */
export function OverloadsNarrowedByParameters(FunctionType: unknown, Args: OverloadParameters<FunctionType>) {
  return UnionToIntersection(SelectOverloadsInfo(OverloadsInfoUnion(FunctionType), Args))
}
/* compiles to:
 * export type OverloadsNarrowedByParameters<FunctionType, Args extends OverloadParameters<FunctionType>> = UnionToIntersection<SelectOverloadsInfo<OverloadsInfoUnion<FunctionType>, Args>>
 */

